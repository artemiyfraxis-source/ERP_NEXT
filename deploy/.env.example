# Copied to deploy/.env by bootstrap.sh (passwords generated there). Never commit deploy/.env.
# «:80» — сервер в локальной сети цеха, сайт по http://<IP>; домен — HTTPS от Let's Encrypt (нужен белый IP).
ERP_DOMAIN=:80
# 1 только за HTTPS; в локальной сети по http — 0, иначе браузер не вернёт cookie входа.
ERP_COOKIE_SECURE=0
# В сети цеха 443 занимает Tailscale (HTTPS снаружи), Caddy туда не лезет.
ERP_HTTPS_PUBLISH=127.0.0.1:8443
POSTGRES_PASSWORD=change-me
# Google (read-only: imports, «Из расчёта»): the key sits in config/secrets/, not in git. КД lives in the database (owner, 29.09).
ERP_GOOGLE_SERVICE_ACCOUNT_JSON=/run/erp-secrets/google-service-account.json
ERP_KD_DRIVE_FOLDER_ID=1cPlM5X6ZSdiPpSajOw1YvBYfOdqGdzfA
BACKUP_HOUR=3
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=36
