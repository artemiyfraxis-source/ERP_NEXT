{$ERP_DOMAIN} {
	encode zstd gzip
	# Banner «Обновление не установилось»: deploy/auto-update.sh writes it on the host, the site polls it.
	handle /update-status.json {
		root * /srv/status
		file_server
	}
	# Result of the last update (deploy/update.sh: ok, step, message, revision, finished_at); the button workflow polls it.
	handle /update-result.json {
		root * /srv/status
		file_server
	}
	handle {
		reverse_proxy api:8000
	}
}
