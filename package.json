{
  "name": "fraxis-erp-next-architecture",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:deploy": "bash test/deploy/run.sh",
    "test:backend": "node scripts/run-backend-tests.mjs",
    "test:frontend": "npm --prefix frontend run check",
    "check": "node --check scripts/run-backend-tests.mjs && npm test && npm run test:backend && npm run test:frontend"
  }
}
