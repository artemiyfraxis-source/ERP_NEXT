#!/usr/bin/env bash
# Stub of the docker CLI for test/deploy/update.test.sh: logs every call to $STUB_LOG and plays back what
# update.sh / rehearse.sh read. Knobs (env): STUB_PLAN (output of the migration plan helper), STUB_HEAD,
# STUB_BUILD_RC, STUB_REHEARSAL_MIGRATE_RC, STUB_PROD_MIGRATE_RC (+ STUB_PROD_MIGRATE_COMMITS: the failed run still moved
# alembic_version), STUB_HEALTH_RC. The production database revision lives in $STUB_STATE/db_rev.
set -u
printf '%s\n' "$*" >> "$STUB_LOG"
case "${1:-}" in
  info) exit 0 ;;
  build) exit "${STUB_BUILD_RC:-0}" ;;
  tag | image) exit 0 ;;
  run) cat > /dev/null; printf '%s\n' "${STUB_PLAN:-}"; exit 0 ;;   # the plan helper: docker run -i <image> python -
  compose) shift ;;
  *) exit 0 ;;
esac
project=erp
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -p) project=$2; shift 2 ;;
    --env-file | -f) shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]}"
if [ "$project" = erp-rehearsal ]; then
  case "$*" in
    *" api sh -s") cat > /dev/null; exit "${STUB_REHEARSAL_MIGRATE_RC:-0}" ;;
    "exec -T"*" pg_restore "*) cat > /dev/null; exit 0 ;;
    "exec -T"*" api python -"*) cat > /dev/null; exit 0 ;;
    *) exit 0 ;;
  esac
fi
case "$*" in
  "exec -T backup bash -s -- --pre-update "*)
    BACKUP_ROOT=$ERP_HOME/backups bash -s -- --pre-update "${!#}"; exit $? ;;
  "exec -T db psql"*) cat "$STUB_STATE/db_rev"; exit 0 ;;
  "run --rm --no-deps -T"*" api sh -s")
    cat > /dev/null
    rc=${STUB_PROD_MIGRATE_RC:-0}
    if [ "$rc" = 0 ] || [ -n "${STUB_PROD_MIGRATE_COMMITS:-}" ]; then echo "$STUB_HEAD" > "$STUB_STATE/db_rev"; fi
    exit "$rc" ;;
  "exec -T api python - "*) cat > /dev/null; exit "${STUB_HEALTH_RC:-0}" ;;
  *) exit 0 ;;
esac
