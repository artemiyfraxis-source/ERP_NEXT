#!/usr/bin/env bash
# Stub of pg_dump for test/deploy: `pg_dump -Fc -f <file>` writes a fake archive.
set -u
out=""
while [ $# -gt 0 ]; do
  case "$1" in -f) out=$2; shift 2 ;; *) shift ;; esac
done
[ -n "$out" ] || exit 2
[ -z "${STUB_PG_DUMP_FAIL:-}" ] || exit 1
printf 'PGDMP stub archive\n' > "$out"
