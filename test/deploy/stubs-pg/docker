#!/usr/bin/env bash
# Stub of the docker CLI for test/deploy/restore-drill.test.sh, over a REAL PostgreSQL: `compose exec` into db/backup
# runs the command here (psql, pg_restore, bash -s of backup-loop.sh) against the drill server from PGHOST/PGPORT/
# PGUSER/PGPASSWORD, with /backups → $ERP_HOME/backups. The image's `alembic heads` and the integrity snapshot run from
# $DRILL_BACKEND with the drill's Python; /api/health?db=1 is «erp is at the given revision»; api/worker are a state
# file ($STUB_STATE/api). Every call goes to $STUB_LOG.
set -u
printf '%s\n' "$*" >> "$STUB_LOG"
case "${1:-}" in
  info) exit 0 ;;
  run) cd "$DRILL_BACKEND" && exec python -m alembic heads ;;   # docker run --rm --network none <image> alembic heads
  compose) shift ;;
  *) exit 0 ;;
esac
while [ $# -gt 0 ]; do   # compose options before the subcommand (a later -f belongs to it: pg_restore -f -)
  case "$1" in --env-file | -f | -p) shift 2 ;; *) break ;; esac
done

case "$1" in
  stop) echo stopped > "$STUB_STATE/api"; exit 0 ;;
  start) echo running > "$STUB_STATE/api"; exit 0 ;;
  up) exit 0 ;;
  run)   # run --rm --no-deps -T -v <dir>:/integrity api sh -c <script> sh <database>
    dir=${6%:/integrity}
    script=${10//\/integrity/$dir}
    cd "$DRILL_BACKEND" && ERP_DATABASE_URL="$DRILL_URL_BASE/erp" exec sh -c "$script" sh "${12}" ;;
  exec) ;;
  *) echo "stub docker: unknown: $*" >&2; exit 1 ;;
esac
shift 2   # exec -T
envs=()
while [ "$1" = -e ]; do envs+=("$2"); shift 2; done
service=$1; shift
case "$service" in
  api)   # python - <head>: the health probe
    cat > /dev/null
    exec python -c 'import sys, sqlalchemy as sa
engine = sa.create_engine(sys.argv[1])
with engine.connect() as connection:
    revision = connection.execute(sa.text("SELECT version_num FROM alembic_version")).scalar_one()
sys.exit(0 if revision == sys.argv[2] else 2)' "$DRILL_URL_BASE/erp" "${@: -1}" ;;
  db | backup)
    mapped=()
    for a in "$@"; do
      case "$a" in /backups/*) mapped+=("$ERP_HOME/backups/${a#/backups/}") ;; *) mapped+=("$a") ;; esac
    done
    exec env ${envs[@]+"${envs[@]}"} BACKUP_ROOT="$ERP_HOME/backups" PGDATABASE=erp "${mapped[@]}" ;;
esac
echo "stub docker: unknown service $service" >&2
exit 1
