{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/statusline.mjs"
  },
  "worktree": {
    "baseRef": "head",
    "symlinkDirectories": [
      "frontend/node_modules",
      "backend/.venv"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/setup-env.mjs && node .claude/hooks/cloud-siblings.mjs && node .claude/hooks/supplymap-drift.mjs",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-migrations.mjs",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run check:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(**/pins-local.md)",
      "Read(**/erp-reader*.json)",
      "Read(**/erp-calc-reader*.json)",
      "Read(//c/secrets/**)"
    ]
  },
  "extraKnownMarketplaces": {
    "claude-code-skills": {
      "source": {
        "source": "github",
        "repo": "alirezarezvani/claude-skills"
      }
    }
  },
  "enabledPlugins": {
    "self-improving-agent@claude-code-skills": true,
    "karpathy-coder@claude-code-skills": true,
    "write-a-skill@claude-code-skills": true,
    "caveman@claude-code-skills": true,
    "grill-me@claude-code-skills": true,
    "handoff-engineering@claude-code-skills": true,
    "reflect-skill@claude-code-skills": true
  }
}
